<Window x:Class="ClipBridge.App.HistoryRetentionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge 历史清理" Height="420" Width="560"
        MinHeight="420" MinWidth="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="本机历史清理" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="按时间清理（天）" Margin="0,0,0,5" />
            <TextBox x:Name="RetentionDaysBox" Height="38" Padding="8,5" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="最多保留记录数" Margin="0,0,0,5" />
            <TextBox x:Name="MaximumItemsBox" Height="38" Padding="8,5" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="最大历史内容容量（MiB）" Margin="0,0,0,5" />
            <TextBox x:Name="MaximumSizeBox" Height="38" Padding="8,5" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Top"
                   Text="默认保留 7 天、最多 300 条；0 表示该项不限。清理按最早记录优先，未同步记录会保留。" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" MinWidth="92" Height="38" Padding="12,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="取消" MinWidth="84" Height="38" Padding="12,0" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
