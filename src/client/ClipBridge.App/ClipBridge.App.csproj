<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ClipBridge</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Icons\clipbridge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\clipbridge.ico" />
    <Resource Include="Assets\Icons\clipbridge_64.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBridge.Core\ClipBridge.Core.csproj" />
    <ProjectReference Include="..\ClipBridge.Storage\ClipBridge.Storage.csproj" />
    <ProjectReference Include="..\ClipBridge.Sync\ClipBridge.Sync.csproj" />
    <ProjectReference Include="..\ClipBridge.Windows\ClipBridge.Windows.csproj" />
  </ItemGroup>

</Project>
