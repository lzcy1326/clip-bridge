<Window x:Class="ClipBridge.App.SyncConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge 设备配对" Height="430" Width="560"
        MinHeight="430" MinWidth="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="ContentGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设备配对" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Grid.Row="0" Text="输入 Server 地址和对端识别码；另一台设备确认后开始同步。"
                   Margin="0,38,0,16" Foreground="#667085" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Server 地址" Margin="0,0,0,4" />
            <TextBox x:Name="ServerAddressBox" Text="http://localhost:10002" Height="38" Padding="8,5" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="本机设备识别码（可修改）" Margin="0,0,0,4" />
            <TextBox x:Name="LocalDeviceCodeBox" Height="38" Padding="8,5" MaxLength="6" CharacterCasing="Upper" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="对端设备识别码（首次配对或添加设备时填写）" Margin="0,0,0,4" />
            <TextBox x:Name="PeerDeviceCodeBox" Height="38" Padding="8,5" MaxLength="6" CharacterCasing="Upper" VerticalContentAlignment="Center" TextChanged="PeerDeviceCodeBox_TextChanged" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#475467" TextWrapping="Wrap" VerticalAlignment="Center" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ConnectButton" Content="启用本机并配对" MinWidth="160" Height="38" Padding="12,0" IsDefault="True" Click="ConnectButton_Click" />
            <Button Content="取消" MinWidth="84" Height="38" Padding="12,0" Margin="8,0,0,0" Click="CancelButton_Click" />
        </StackPanel>

        <Border x:Name="LoadingOverlay" Grid.RowSpan="6" Panel.ZIndex="10"
                Background="#CCFFFFFF" Visibility="Collapsed" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" Height="8" IsIndeterminate="True" />
                <TextBlock Text="正在连接并登记设备，请稍候…" FontSize="16" Foreground="#344054"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
