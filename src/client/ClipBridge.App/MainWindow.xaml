<Window x:Class="ClipBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Height="700" Width="680"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ClipBridge" FontSize="28" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock Text="跨设备剪贴板" Margin="0,6,0,0" FontSize="14" Foreground="#596773" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,18" Padding="14,11" CornerRadius="8" Background="#E8F1FB">
            <TextBlock x:Name="ClipboardStatusText" Text="等待复制文本。"
                       FontSize="13" Foreground="#2563A6" />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="最近复制" FontSize="17" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock x:Name="HistoryCountText" Grid.Column="1" Text="0 条"
                       VerticalAlignment="Center" FontSize="12" Foreground="#71808D" />
        </Grid>

        <Border Grid.Row="3" Padding="6" CornerRadius="10" Background="White">
            <Grid>
                <ListBox x:Name="HistoryList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding TextContent}"
                                           ToolTip="{Binding TextContent}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           FontSize="14" Foreground="#263442" />
                                <TextBlock Grid.Row="1" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                           Margin="0,5,0,0" FontSize="11" Foreground="#82909B" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHistoryText" Text="复制的文本会显示在这里。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#82909B" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
