<Window x:Class="ClipBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Height="340" Width="540"
        MinHeight="340" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ClipBridge" FontSize="28" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock Text="跨设备剪贴板" Margin="0,6,0,0" FontSize="14" Foreground="#596773" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,20" Padding="18" CornerRadius="10" Background="White">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="应用正在运行" FontSize="18" FontWeight="SemiBold" Foreground="#17212B" />
                <TextBlock Text="ClipBridge 已启动。剪贴板功能将在后续版本逐步加入。"
                           Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" Foreground="#596773" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="你可以从系统托盘打开或退出 ClipBridge。"
                   FontSize="12" Foreground="#71808D" />
    </Grid>
</Window>
