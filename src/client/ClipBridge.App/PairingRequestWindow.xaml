<Window x:Class="ClipBridge.App.PairingRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge 配对请求"
        Width="460" Height="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClipBridge;component/Assets/Icons/clipbridge.ico"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="收到设备配对请求" FontSize="23" FontWeight="SemiBold" Foreground="#172B4D" />
        <TextBlock Grid.Row="1" Text="请求设备" Margin="0,18,0,4" Foreground="#667085" />
        <TextBlock x:Name="RequesterText" Grid.Row="2" FontSize="18" Foreground="#172B4D" />
        <TextBlock x:Name="SourceText" Grid.Row="3" Margin="0,8,0,8" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Top" />
        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RejectButton" Content="拒绝" MinWidth="90" Height="38" Padding="12,0" Click="RejectButton_Click" />
            <Button x:Name="AcceptButton" Content="确认配对" MinWidth="120" Height="38" Padding="12,0" Margin="10,0,0,0" IsDefault="True" Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>
